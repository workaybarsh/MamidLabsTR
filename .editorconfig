root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true

# PowerShell betikleri UTF-8 BOM ile saklanir: Windows PowerShell 5.1 BOM'suz
# dosyalardaki Turkce karakterleri bozuk okur.
[*.ps1]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.py]
charset = utf-8
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
charset = utf-8
trim_trailing_whitespace = false
